# ===========================================
# Harven AI V2 — Environment Variables
# ===========================================

# --- Application ---
ENVIRONMENT=development
PORT=8000

# --- Supabase ---
# Names must match exactly what the code reads (config.py:11-12, database.py:5-6).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# --- Authentication ---
# JWT_SECRET_KEY MUST be >= 32 characters (e.g. `openssl rand -hex 32`).
# In production the backend fails the boot (RuntimeError) if this is empty,
# the literal "change-me-in-production"/"your-secret-key-here", or < 32 chars
# (fail-closed boot-guard — see SEC-ATO-2).
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars

# --- Frontend API URL ---
VITE_API_URL=https://api.harven.eximiaventures.com.br

# --- AI / LLM ---
OPENAI_API_KEY=sk-your-openai-key

# --- Upload ---
UPLOAD_MAX_SIZE_MB=50

# --- Moodle integration (SEC-SCOPE-5) ---
# Shared secret used to verify the HMAC-SHA256 signature (X-Moodle-Signature header,
# computed over the raw request body) on POST /integrations/moodle/webhook.
# In production, an empty secret makes the webhook fail-closed (401 on every call).
# May also be set in the system_settings.moodle_webhook_secret admin field.
MOODLE_WEBHOOK_SECRET=

# --- LTI integration (SEC-SCOPE-6) ---
# LTI is opt-in: disabled unless LTI_ENABLED=true.
LTI_ENABLED=false
LTI_CONSUMER_KEY=
LTI_SHARED_SECRET=
LTI_REDIRECT_URL=
# Auto-provisioning of LTI users now defaults to FALSE (was true). With it off, an
# unknown LTI user yields 403 instead of an auto-created account. Note: LTI roles
# NEVER grant ADMIN — a forged roles=administrator is capped at STUDENT; ADMIN is
# granted out-of-band only. Auto-created accounts get a random unusable password
# (cannot be logged in via /auth/login with the RA/user_id).
LTI_AUTO_CREATE_USERS=false

# --- Sentry (error monitoring) ---
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Ports (local dev) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
