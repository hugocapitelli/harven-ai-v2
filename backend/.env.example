# Supabase — names must match config.py:11-12 and database.py:5-6 exactly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
# JWT_SECRET_KEY MUST be >= 32 characters (e.g. `openssl rand -hex 32`).
# In production the backend fails the boot (RuntimeError) if this is empty,
# the literal "change-me-in-production"/"your-secret-key-here", or < 32 chars
# (fail-closed boot-guard — see SEC-ATO-2).
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
UPLOAD_DIR=./uploads
PORT=8000
# --- Moodle webhook (SEC-SCOPE-5) ---
# HMAC-SHA256 shared secret for POST /integrations/moodle/webhook. Empty + production
# => fail-closed (401). Also resolvable from system_settings.moodle_webhook_secret.
MOODLE_WEBHOOK_SECRET=
# --- LTI (SEC-SCOPE-6) ---
# Auto-provisioning defaults to false; LTI roles never grant ADMIN; created accounts
# receive a random unusable password.
LTI_ENABLED=false
LTI_CONSUMER_KEY=
LTI_SHARED_SECRET=
LTI_AUTO_CREATE_USERS=false
